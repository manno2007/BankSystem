@model BankSystem.Web.Models.Customer

@{
    ViewData["Title"] = "Complete Profile";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-6">
        <div class="glass-card animate-fade-in p-5">
            <div class="text-center mb-4">
                <i class="bi bi-person-lines-fill text-primary" style="font-size: 3rem;"></i>
                <h2 class="mt-3">Complete Your Profile</h2>
                <p class="text-muted">We need a few more details to set up your banking profile.</p>
            </div>
            
            <form asp-action="CreateProfile">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label">First Name (Optional if set)</label>
                        <input asp-for="FirstName" class="form-control glass-input" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label">Last Name (Optional if set)</label>
                        <input asp-for="LastName" class="form-control glass-input" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="DateOfBirth" class="form-label">Date of Birth</label>
                    <input asp-for="DateOfBirth" type="date" class="form-control glass-input" required />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
                
                <div class="mb-4">
                    <label asp-for="Address" class="form-label">Address</label>
                    <textarea asp-for="Address" class="form-control glass-input" rows="3" required></textarea>
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
                
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-premium btn-lg">Save Profile</button>
                </div>
            </form>
        </div>
    </div>
</div>
