@model BankSystem.Web.Models.ViewModels.StatementViewModel
<h2>Account Statement</h2>
<table class="table">
    <thead><tr><th>Date</th><th>Type</th><th>Description</th><th>Amount</th></tr></thead>
    <tbody>
        @foreach(var tx in Model.Transactions) {
            <tr>
                <td>@tx.TransactionDate.ToShortDateString()</td>
                <td>@tx.Type</td>
                <td>@tx.Description</td>
                <td>@tx.Amount.ToString("C")</td>
            </tr>
        }
    </tbody>
</table>
