@model BankSystem.Web.Models.Loan

@{
    ViewData["Title"] = "Apply for Loan";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="glass-card animate-fade-in p-5">
            <h3 class="mb-4"><i class="bi bi-cash-stack text-success me-2"></i> Apply for a Loan</h3>
            
            <form asp-action="Apply">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="mb-4">
                    <label asp-for="PrincipalAmount" class="form-label">Requested Amount ($)</label>
                    <div class="input-group">
                        <span class="input-group-text glass-input border-end-0 bg-transparent"><i class="bi bi-currency-dollar"></i></span>
                        <input asp-for="PrincipalAmount" class="form-control glass-input border-start-0" type="number" step="0.01" />
                    </div>
                    <span asp-validation-for="PrincipalAmount" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="DurationMonths" class="form-label">Duration (Months)</label>
                    <input asp-for="DurationMonths" class="form-control glass-input" type="number" min="12" max="360" />
                    <span asp-validation-for="DurationMonths" class="text-danger"></span>
                </div>
                
                <div class="mb-4">
                    <label asp-for="InterestRate" class="form-label">Interest Rate (%)</label>
                    <input asp-for="InterestRate" class="form-control glass-input" type="number" step="0.1" value="5.5" readonly />
                    <small class="text-muted">Standard rate applied.</small>
                </div>
                
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-premium btn-lg">Submit Application</button>
                    <a asp-controller="Customer" asp-action="Dashboard" class="btn btn-glass mt-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
