@model BankSystem.Web.Models.ViewModels.DepositViewModel

@{
    ViewData["Title"] = "Deposit Funds";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="glass-card animate-fade-in p-5">
            <h3 class="mb-4"><i class="bi bi-arrow-down-circle text-success me-2"></i> Deposit Funds</h3>
            
            <form asp-action="Deposit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="mb-4">
                    <label asp-for="AccountId" class="form-label">Select Account</label>
                    <select asp-for="AccountId" class="form-control glass-input" asp-items="@(new SelectList(ViewBag.Accounts, "Id", "AccountNumber"))">
                        <option value="">-- Select Account --</option>
                    </select>
                    <span asp-validation-for="AccountId" class="text-danger"></span>
                </div>
                
                <div class="mb-4">
                    <label asp-for="Amount" class="form-label">Amount ($)</label>
                    <div class="input-group">
                        <span class="input-group-text glass-input border-end-0 bg-transparent"><i class="bi bi-currency-dollar"></i></span>
                        <input asp-for="Amount" class="form-control glass-input border-start-0" type="number" step="0.01" />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>
                
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-premium btn-lg">Complete Deposit</button>
                    <a asp-controller="Customer" asp-action="Dashboard" class="btn btn-glass mt-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
